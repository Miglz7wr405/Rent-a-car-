generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Vehicle {
  id            String         @id @default(cuid())
  slug          String         @unique
  brand         String
  model         String
  year          Int
  category      String
  seats         Int
  transmission  String
  fuel          String
  dailyRateMzn  Int
  description   String
  mainImage     String
  status        String         @default("AVAILABLE")
  images        VehicleImage[]
  bookings      Booking[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  url       String
  order     Int     @default(0)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Booking {
  id               String   @id @default(cuid())
  reference        String   @unique
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  customerName     String
  customerPhone    String
  customerEmail    String?
  pickupAt         DateTime
  returnAt         DateTime
  pickupLocation   String?
  totalEstimateMzn Int
  status           String   @default("PENDING")
  notes            String?
  createdAt        DateTime @default(now())
}

model Settings {
  id        Int      @id @default(1)
  phone     String   @default("+258 84 411 6974")
  whatsapp  String   @default("258844116974")
  email     String   @default("")
  address   String   @default("Avenida de Maputo, Quelimane, Moçambique")
  hoursText String   @default("")
  updatedAt DateTime @updatedAt
}
