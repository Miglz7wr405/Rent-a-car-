# ───────────────────────────────────────────────────────────
# Em produção (Vercel): NÃO PRECISAS DE PREENCHER NADA AQUI.
# A Vercel liga sozinha a DATABASE_URL quando crias a base de dados
# em Storage → Create Database → Postgres.
# ───────────────────────────────────────────────────────────

# Base de dados Postgres (Vercel preenche automaticamente em produção)
DATABASE_URL="postgresql://user:pass@localhost:5432/kakeylka"

# NextAuth — opcional em produção (Vercel gera um fallback estável).
# Para produção séria, define um valor próprio: `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# Admin inicial — opcional. Se omitido, o seed gera uma password
# aleatória e imprime no Build Log da Vercel.
ADMIN_SEED_EMAIL="admin@kakeylka.co.mz"
ADMIN_SEED_PASSWORD=""
