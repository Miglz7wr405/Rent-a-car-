# Postgres (Neon) — URL com pooler para a app
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/kakeylka?sslmode=require"
# URL direto (sem pooler) para migrações do Prisma
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/kakeylka?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-32-char-random-string"

# Admin inicial (criado pelo seed na primeira execução)
ADMIN_SEED_EMAIL="admin@kakeylka.co.mz"
ADMIN_SEED_PASSWORD="change-me-after-first-login"
